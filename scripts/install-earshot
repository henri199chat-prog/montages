#!/usr/bin/env bash
# Install the vendored earshot (tools/earshot, MIT) into ~/.earshot-venv.
#   scripts/install-earshot          light: sfx, kit, measure (no models)
#   scripts/install-earshot --full   adds CPU torch + transformers: describe, match, find, critique, forge...
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENV="$HOME/.earshot-venv"
[ -x "$VENV/bin/python" ] || python3 -m venv "$VENV"
"$VENV/bin/pip" install -q numpy scipy soundfile soxr librosa pyloudnorm scikit-learn pillow matplotlib
if [ "${1:-}" = "--full" ]; then
  "$VENV/bin/pip" install -q torch --index-url https://download.pytorch.org/whl/cpu
  "$VENV/bin/pip" install -q -e "$ROOT/tools/earshot[mcp]"
else
  "$VENV/bin/pip" install -q --no-deps -e "$ROOT/tools/earshot"
fi
"$VENV/bin/earshot" sfx list | head -1
echo "ready: $VENV/bin/earshot"
