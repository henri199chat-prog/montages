#!/usr/bin/env bash
# Speak any text in the creator's own cloned voice (OmniVoice, Apache-2.0, CPU).
#   scripts/my-voice setup REF_AUDIO "exact words spoken in REF_AUDIO"   once per session; 3-10 s clean clip
#   scripts/my-voice lines DIR lines.txt [seed]     one take per line -> DIR/NN.wav (skips lines already made)
#   scripts/my-voice retake DIR N "text" SEED       redo line N (1-based) only
#   scripts/my-voice check DIR lines.txt            Whisper every line: word match, repeats, long pauses
#   scripts/my-voice join DIR OUT.wav [pause]       join lines with pauses (default 0.45 s) + studio chain, -16 LUFS
# The voice lives only in ~/.my-voice and ignored folders (never in the repo; the repo is public).
set -euo pipefail
V=$HOME/.omni-venv; D=$HOME/.my-voice; HERE=$(cd "$(dirname "$0")" && pwd)
[ -x "$V/bin/python" ] || { python3 -m venv "$V"
  "$V/bin/pip" install -q torch==2.8.0 torchaudio==2.8.0 --index-url https://download.pytorch.org/whl/cpu
  "$V/bin/pip" install -q omnivoice; }
mkdir -p "$D"; chmod 700 "$D"
gen() { # gen DIR SEED FIRST_INDEX text...
  "$V/bin/python" - "$@" <<'PY'
import os, sys, time, torch, numpy as np, soundfile as sf
from omnivoice import OmniVoice, VoiceClonePrompt
torch.set_num_threads(os.cpu_count() or 4)
out, seed, first, lines = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), sys.argv[4:]
todo = [(first + i, t) for i, t in enumerate(lines) if not os.path.exists(f"{out}/{first + i:02d}.wav") or len(lines) == 1]
if not todo:
    sys.exit(0)
m = OmniVoice.from_pretrained("k2-fsa/OmniVoice", device_map="cpu", dtype=torch.float32)
p = VoiceClonePrompt.load(os.path.expanduser("~/.my-voice/voice.pt"))
for n, t in todo:
    torch.manual_seed(seed + n); s = time.time()
    a = m.generate(text=t, voice_clone_prompt=p, num_step=32)[0].astype(np.float32)
    idx = np.where(np.abs(a) > 0.01)[0]
    a = a[max(0, idx[0] - 600): idx[-1] + 1200] if len(idx) else a
    sf.write(f"{out}/{n:02d}.wav", a, 24000)
    print(f"line {n}: {len(a)/24000:.1f}s ({time.time()-s:.0f}s)", flush=True)
PY
}
case "${1:-}" in
setup)
  ffmpeg -loglevel error -y -i "$2" -af "highpass=f=70" -ac 1 -ar 24000 "$D/ref.wav"
  printf '%s\n' "$3" > "$D/ref.txt"
  "$V/bin/python" - <<'PY'
import os, torch
from omnivoice import OmniVoice
d = os.path.expanduser("~/.my-voice")
m = OmniVoice.from_pretrained("k2-fsa/OmniVoice", device_map="cpu", dtype=torch.float32)
m.create_voice_clone_prompt(ref_audio=f"{d}/ref.wav", ref_text=open(f"{d}/ref.txt").read().strip()).save(f"{d}/voice.pt")
print("voice saved in ~/.my-voice")
PY
  ;;
lines)
  DIR=$2; mkdir -p "$DIR"; mapfile -t L < <(grep -v '^\s*$' "$3")
  [ -f "$D/voice.pt" ] || { echo "no voice yet: scripts/my-voice setup clip.mp3 \"words\""; exit 2; }
  gen "$DIR" "${4:-7}" 1 "${L[@]}";;
retake)
  gen "$2" "$5" "$3" "$4";;
check)
  "$HOME/.whisper-venv/bin/python" "$HERE/my-voice-check.py" "$2" "$3";;
join)
  DIR=$2; OUT=$3; P=${4:-0.45}; TMP=$(mktemp -d)
  ffmpeg -loglevel error -y -f lavfi -i anullsrc=r=24000:cl=mono -t "$P" "$TMP/gap.wav"
  ffmpeg -loglevel error -y -f lavfi -i anullsrc=r=24000:cl=mono -t 0.25 "$TMP/lead.wav"
  { echo "file '$TMP/lead.wav'"; first=1; for f in "$DIR"/[0-9][0-9].wav; do
      [ $first = 1 ] || echo "file '$TMP/gap.wav'"; first=0; echo "file '$(cd "$(dirname "$f")" && pwd)/$(basename "$f")'"; done; } > "$TMP/list.txt"
  ffmpeg -loglevel error -y -f concat -safe 0 -i "$TMP/list.txt" -ar 24000 -ac 1 "$TMP/raw.wav"
  ffmpeg -loglevel error -y -i "$TMP/raw.wav" -af "highpass=f=80,equalizer=f=120:t=q:w=0.9:g=2,equalizer=f=320:t=q:w=1.2:g=-2.5,equalizer=f=3800:t=q:w=1.2:g=2,acompressor=threshold=-24dB:ratio=3:attack=5:release=90:makeup=2,loudnorm=I=-16:TP=-1.5" -ar 48000 -ac 1 "$OUT"
  rm -rf "$TMP"; echo "saved $OUT";;
*) sed -n 2,9p "$0";;
esac
